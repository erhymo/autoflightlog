rules_version = '2';

// Data model (see src/lib/repo/firestoreRepos.ts): every document the client
// SDK touches lives under users/{uid}/{collection}/{docId}. There is no
// top-level users/{uid} document. Admin operations (src/app/api/admin/**)
// go through the Firebase Admin SDK on the server and bypass these rules
// entirely, so they don't need an allowance here.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // No top-level user document is read/written by the client today.
      allow read, write: if false;

      // Owner-only collections used by src/lib/repo/firestoreRepos.ts.
      match /templates/{templateId} {
        allow read, write: if isOwner(uid);
      }

      match /views/{viewId} {
        allow read, write: if isOwner(uid);
      }

      match /entries/{entryId} {
        allow read, write: if isOwner(uid);
      }

      match /flags/{flagId} {
        allow read, write: if isOwner(uid);
      }

      match /integrationRequests/{requestId} {
        allow read, write: if isOwner(uid);
      }

      match /connectors/{connectorId} {
        allow read, write: if isOwner(uid);
      }

      match /certificates/{certificateId} {
        allow read, write: if isOwner(uid);
      }

      // Admin-managed metadata (e.g. the `hidden` flag set from /app/admin).
      // Only ever read/written server-side via the Admin SDK, which bypasses
      // these rules — deny client access outright so a user can't read or
      // rewrite their own admin flags.
      match /meta/{document=**} {
        allow read, write: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
