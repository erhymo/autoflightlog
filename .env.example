### Firebase (Client / Next.js public env)
# These are used by src/lib/firebase/client.ts
# Copy to .env.local and fill in values from Firebase Console → Project settings → General → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

### Server-only (API routes). Required for admin panel, employer setup and flight sync.
# Firebase Admin service account: Firebase Console → Project settings → Service accounts → Generate new private key.
# Either the whole JSON (raw or base64) ...
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=
# ... or the three fields split out
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Who may use /app/admin (comma-separated emails). The NEXT_PUBLIC_ copy only shows/hides the nav link.
ADMIN_EMAIL_ALLOWLIST=
NEXT_PUBLIC_ADMIN_EMAIL_ALLOWLIST=

# Encrypts employer API keys/tokens at rest. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_SECRET_KEY=

# Protects the scheduled sync endpoint (/api/sync/run). Vercel Cron sends it automatically. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
